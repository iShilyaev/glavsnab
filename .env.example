# Скопируйте в .env для локальной разработки:
#   cp .env.example .env
#
# Прод на GitHub Pages берёт эти значения из
# Settings → Secrets and variables → Actions.
# В клиент попадают только переменные с префиксом VITE_.

# Базовый путь Vite. Локально — /
VITE_BASE_PATH=/

# Общий webhook (заготовка). Если CRM_WEBHOOK_URL пуст, лид уходит сюда.
VITE_WEBHOOK_URL=https://google.com

# Webhook amoCRM. Пока пусто — будет подключено позже.
VITE_CRM_WEBHOOK_URL=

# Ссылка на чат-бот MAX. Пока заглушка на max.ru
VITE_MAX_BOT_URL=https://max.ru
